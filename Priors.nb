Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{"Mean", "[", 
  RowBox[{"InverseGaussianDistribution", "[", 
   RowBox[{"\[Mu]", ",", "\[Lambda]", ",", "\[Theta]"}], "]"}], 
  "]"}]], "Input",
 CellLabel->
  "In[431]:=",ExpressionUUID->"d764b63e-a7b0-4571-a84e-1336e7b5e3af"],

Cell[BoxData[
 FractionBox[
  RowBox[{"\[Mu]", " ", 
   RowBox[{"BesselK", "[", 
    RowBox[{
     RowBox[{"1", "+", "\[Theta]"}], ",", 
     FractionBox["\[Lambda]", "\[Mu]"]}], "]"}]}], 
  RowBox[{"BesselK", "[", 
   RowBox[{"\[Theta]", ",", 
    FractionBox["\[Lambda]", "\[Mu]"]}], "]"}]]], "Output",
 CellChangeTimes->{3.8115159906034203`*^9},
 CellLabel->
  "Out[431]=",ExpressionUUID->"03f82698-a481-42ac-9383-35b6e85a6e71"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Variance", "[", 
  RowBox[{"InverseGaussianDistribution", "[", 
   RowBox[{"\[Mu]", ",", "\[Lambda]", ",", "\[Theta]"}], "]"}], 
  "]"}]], "Input",
 CellLabel->
  "In[432]:=",ExpressionUUID->"af114146-58e6-4269-9489-d0e2657fa023"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    SuperscriptBox["\[Mu]", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox[
        RowBox[{"BesselK", "[", 
         RowBox[{
          RowBox[{"1", "+", "\[Theta]"}], ",", 
          FractionBox["\[Lambda]", "\[Mu]"]}], "]"}], "2"]}], "+", 
      RowBox[{
       RowBox[{"BesselK", "[", 
        RowBox[{"\[Theta]", ",", 
         FractionBox["\[Lambda]", "\[Mu]"]}], "]"}], " ", 
       RowBox[{"BesselK", "[", 
        RowBox[{
         RowBox[{"2", "+", "\[Theta]"}], ",", 
         FractionBox["\[Lambda]", "\[Mu]"]}], "]"}]}]}], ")"}]}], ")"}], "/", 
  
  SuperscriptBox[
   RowBox[{"BesselK", "[", 
    RowBox[{"\[Theta]", ",", 
     FractionBox["\[Lambda]", "\[Mu]"]}], "]"}], "2"]}]], "Output",
 CellChangeTimes->{3.8115160017158413`*^9},
 CellLabel->
  "Out[432]=",ExpressionUUID->"4754e68d-de68-4c19-8be7-c137e1eee909"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Refine", "[", 
  RowBox[{
   RowBox[{"PDF", "[", 
    RowBox[{
     RowBox[{"InverseGaussianDistribution", "[", 
      RowBox[{"\[Mu]", ",", "\[Lambda]", ",", "\[Theta]"}], "]"}], ",", "x"}],
     "]"}], ",", 
   RowBox[{"x", ">", "0"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.811261022666643*^9, 3.8112610308207684`*^9}, {
  3.811512408731063*^9, 3.8115124351392593`*^9}, {3.811515565741912*^9, 
  3.8115155690238543`*^9}},
 CellLabel->
  "In[421]:=",ExpressionUUID->"fcffa15b-d1fc-46c7-a6f6-325cf2347338"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"\[Lambda]", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         FractionBox[
          SuperscriptBox["x", "2"], 
          SuperscriptBox["\[Mu]", "2"]]}], ")"}]}], 
      RowBox[{"2", " ", "x"}]]}]], " ", 
   SuperscriptBox["x", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "\[Theta]"}]], " ", 
   SuperscriptBox["\[Mu]", 
    RowBox[{"-", "\[Theta]"}]]}], 
  RowBox[{"2", " ", 
   RowBox[{"BesselK", "[", 
    RowBox[{"\[Theta]", ",", 
     FractionBox["\[Lambda]", "\[Mu]"]}], "]"}]}]]], "Output",
 CellChangeTimes->{
  3.811261031424533*^9, 3.8112610709930277`*^9, {3.8115124249467363`*^9, 
   3.8115124353817043`*^9}, {3.811515570051056*^9, 3.811515577275502*^9}},
 CellLabel->
  "Out[421]=",ExpressionUUID->"b8e59b00-ac6e-4dd7-aaf9-ea4bd52a016d"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"pdfgig", "[", 
    RowBox[{"\[Mu]_", ",", "\[Lambda]_", ",", "\[Theta]_", ",", "x_"}], "]"}],
    ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"x", "\[LessEqual]", "0"}], ",", "0", ",", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"\[Lambda]", " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             FractionBox[
              SuperscriptBox["x", "2"], 
              SuperscriptBox["\[Mu]", "2"]]}], ")"}]}], 
          RowBox[{"2", " ", "x"}]]}]], " ", 
       SuperscriptBox["x", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "\[Theta]"}]], " ", 
       SuperscriptBox["\[Mu]", 
        RowBox[{"-", "\[Theta]"}]]}], 
      RowBox[{"2", " ", 
       RowBox[{"BesselK", "[", 
        RowBox[{"\[Theta]", ",", 
         FractionBox["\[Lambda]", "\[Mu]"]}], "]"}]}]]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.811515580083736*^9, 3.811515598590785*^9}, {
  3.8115157343301973`*^9, 3.8115157502615957`*^9}},
 CellLabel->
  "In[422]:=",ExpressionUUID->"9347220a-d992-4ac3-878e-88dc229d5cb7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", 

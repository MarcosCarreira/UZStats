Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"kernlat", "[", 
    RowBox[{"\[Alpha]_", ",", "\[Beta]_", ",", "t_", ",", "t0_"}], "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"t", "\[GreaterEqual]", "t0"}], ",", 
     RowBox[{"\[Alpha]", " ", "\[Beta]", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[Beta]"}], " ", 
        RowBox[{"(", 
         RowBox[{"t", "-", "t0"}], ")"}]}]]}], ",", "0"}], "]"}]}], 
  ";"}]], "Input",

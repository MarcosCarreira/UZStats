\begin_inset Separator latexpar
\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize
Each price change is determined by a pair of random numbers 
\begin_inset Formula $\left\{ r_{1},r_{2}\right\} $
\end_inset

:
\end_layout

\begin_deeper
\begin_layout Itemize
The first determines whether the next trade is Up or Down given the sign
 of the last trade: 
\begin_inset Formula $sud_{j}=-ud_{j-1}$
\end_inset

 
\end_layout

\begin_layout Itemize
The second determines the duration between price changes:
\end_layout

\end_deeper
\begin_layout Standard
\begin_inset Formula 
\[
\frac{P_{\pm}\left(t\right)}{P_{\pm}}=r_{2}
\]

\end_inset


\end_layout

\begin_layout Itemize
The distribution of price changes of more than one tick can be a variable
 of the (parameters of the) simulation as well
\end_layout

\begin_layout Itemize
Not only realistic price changes but realistic durations
\end_layout

\end_deeper

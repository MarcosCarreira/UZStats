\begin_deeper
\begin_layout Itemize
For Up and Down moves: 
\begin_inset Formula $\rho_{+}=\frac{P_{+}^{A}}{P_{+}^{A}+P_{-}^{A}}$
\end_inset

 and 
\begin_inset Formula $\rho_{-}=\frac{P_{-}^{A}}{P_{+}^{A}+P_{-}^{A}}$
\end_inset


\end_layout

\begin_layout Itemize
For Alternations (this holds well in the data I've seen so far):
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\rho_{+}^{A}=\rho_{-}^{A}=\frac{P_{+}^{A}\cdot P_{-}^{A}}{P_{+}^{A}+P_{-}^{A}}
\]

\end_inset


\end_layout

\begin_layout Itemize
For Continuations Up:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\rho_{+}^{C}=\frac{P_{+}^{A}\cdot\left(1-P_{-}^{A}\right)}{P_{+}^{A}+P_{-}^{A}}
\]

\end_inset


\end_layout

\begin_layout Itemize
For Continuations Down:
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\rho_{-}^{C}=\frac{\left(1-P_{+}^{A}\right)\cdot P_{-}^{A}}{P_{+}^{A}+P_{-}^{A}}
\]

\end_inset


\end_layout

\end_deeper

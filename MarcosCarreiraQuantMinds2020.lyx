\begin_layout Itemize
Updated estimator for a better treatment of large moves
\end_layout

\begin_layout Itemize
Durations (unconditional and conditional) estimators including 
\begin_inset Formula $\left(\mu\neq0\right)$
\end_inset


\end_layout

\begin_layout Itemize
The count 
\begin_inset Formula $\frac{N^{C}}{2\cdot N^{A}}$
\end_inset

 is now equal to 
\begin_inset Formula $\frac{P_{+}^{A}+P_{-}^{A}}{4\cdot P_{+}^{A}\cdot P_{-}^{A}}-\frac{1}{2}\geq\eta$
\end_inset



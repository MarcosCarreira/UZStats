\begin_deeper
\begin_layout Standard
\begin_inset Formula 
\[
\theta=\left\{ \eta,\sigma,\mu\right\} :p\left(\theta\;\middle\vert\;x\right)=p\left(x\;\middle\vert\;\theta\right)\cdot p\left(\theta\right)
\]

\end_inset


\end_layout

\begin_layout Itemize
Where x is the relevant data for each change in price (tick size, sign and
 size of the move in ticks, time from previous price change)
\end_layout

\begin_layout Itemize
The likelihood 
\begin_inset Formula $p\left(x\;\middle\vert\;\theta\right)$
\end_inset

 is given by the pdf corresponding to 
\begin_inset Formula $P_{\pm}\left(t\right)$
\end_inset

 as previously defined
\end_layout

\begin_layout Itemize
But remember that it won't help much with μ specially around 
\begin_inset Formula $\mu=0$
\end_inset


\end_layout

\begin_layout Itemize
In this particular implementation I discretized the grid quite coarsely
\end_layout

\begin_layout Itemize
Different paths for efficient price, same random numbers, parameters change
 midway through (could do it for tick size as well)
\end_layout

\begin_layout Itemize
Base case: 
\begin_inset Formula $\theta=\left\{ \eta,\sigma,\mu\right\} =\left\{ 0.35,0.01,0\right\} $
\end_inset


\end_layout


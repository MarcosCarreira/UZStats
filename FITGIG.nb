   StripOnInput->False],
  InformationData[
   Association[
   "ObjectType" -> "Symbol", "Usage" -> "Global`Ptinf", "Documentation" -> 
    None, "OwnValues" -> None, "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, $CellContext`Ptinf, {$CellContext`Ptinf[
         Pattern[$CellContext`sud, 
          Blank[]], 
         Pattern[$CellContext`ud, 
          Blank[]], 
         Pattern[$CellContext`s0, 
          Blank[]], 
         Pattern[$CellContext`\[Alpha], 
          Blank[]], 
         Pattern[$CellContext`\[Eta], 
          Blank[]], 
         Pattern[$CellContext`\[Sigma], 
          Blank[]], 
         Pattern[$CellContext`\[Mu], 
          Blank[]]] :> 
       Module[{$CellContext`\[Omega], $CellContext`x0, $CellContext`b1, \
$CellContext`b2}, $CellContext`\[Omega] = $CellContext`\[Mu] - (1/
            2) $CellContext`\[Sigma]^2; $CellContext`x0 = 
          Log[$CellContext`s0 + $CellContext`sud (
              1/2 - $CellContext`\[Eta]) $CellContext`\[Alpha]]; \
$CellContext`b1 = 
          Log[$CellContext`s0 + $CellContext`ud (
              1/2 + $CellContext`\[Eta]) $CellContext`\[Alpha]]; \
$CellContext`b2 = 
          Log[$CellContext`s0 - $CellContext`ud (
             1/2 + $CellContext`\[Eta]) $CellContext`\[Alpha]]; 
         If[$CellContext`\[Omega] == 
           0, ($CellContext`b2 - $CellContext`x0)/($CellContext`b2 - \
$CellContext`b1), 
           E^(($CellContext`\[Omega]/$CellContext`\[Sigma]^2) \
($CellContext`b1 - $CellContext`x0) (1 - 
              Sign[$CellContext`\[Omega]] $CellContext`ud)) ((1 - 
             E^(2 (Abs[$CellContext`\[Omega]]/$CellContext`\[Sigma]^2) \
$CellContext`ud ($CellContext`b2 - $CellContext`x0)))/(1 - 
            E^(2 (Abs[$CellContext`\[Omega]]/$CellContext`\[Sigma]^2) \
$CellContext`ud ($CellContext`b2 - $CellContext`b1))))]]}], "SubValues" -> 
    None, "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> None, "Attributes" -> {}, "FullName" -> "Global`Ptinf"], 
   False]]], "Output",

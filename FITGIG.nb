Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"multlikelnet", "[", 
    RowBox[{
    "s0_", ",", "\[Alpha]_", ",", "\[Eta]_", ",", "\[Sigma]_", ",", "\[Mu]_", 
     ",", "x_", ",", "\[Eta]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "f4", "}"}], ",", 
     RowBox[{
      RowBox[{"f4", "=", 
       RowBox[{"Freq4", "[", 
        RowBox[{
        "s0", ",", "\[Alpha]", ",", "\[Eta]", ",", "\[Sigma]", ",", "\[Mu]"}],
         "]"}]}], ";", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         FractionBox[
          SuperscriptBox["\[Sigma]", "2"], 
          RowBox[{"(", 
           FractionBox["\[Alpha]", "s0"], ")"}]], 
         RowBox[{"ArcTanh", "[", 
          FractionBox[
           RowBox[{
            RowBox[{
            "x", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], "-", 
            
            RowBox[{
            "x", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}]}], 
           RowBox[{"2", "\[Eta]", " ", 
            RowBox[{"Total", "[", "x", "]"}]}]], "]"}]}], ",", 
        RowBox[{"Simplify", "[", 
         RowBox[{"Refine", "[", 
          RowBox[{
           RowBox[{"multlikel", "[", 
            RowBox[{"f4", ",", "x"}], "]"}], ",", 
           RowBox[{"\[Sigma]", ">", "0"}]}], "]"}], "]"}]}], "}"}]}]}], 
    "]"}]}], ";"}]], "Input",

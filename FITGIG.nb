Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Ptk", "[", 
    RowBox[{
    "sud_", ",", "ud_", ",", "s0_", ",", "\[Alpha]_", ",", "\[Eta]_", ",", 
     "\[Sigma]_", ",", "\[Mu]_", ",", "t_", ",", 
     RowBox[{"k_", ":", "1"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Omega]", ",", "x0", ",", "b1", ",", "b2", ",", "yn", ",", "zn", ",", 
       
       RowBox[{"n", "=", "0"}], ",", 
       RowBox[{"ans", "=", "0"}], ",", 
       RowBox[{"\[Epsilon]", "=", 
        SuperscriptBox["10", 
         RowBox[{"-", "10"}]]}], ",", 
       RowBox[{"pn", "=", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"t", "\[Equal]", "0"}], ",", "0", ",", "\[IndentingNewLine]", 
        
        RowBox[{
         RowBox[{"\[Omega]", "=", 
          RowBox[{"\[Mu]", "-", 
           RowBox[{
            FractionBox["1", "2"], 
            SuperscriptBox["\[Sigma]", "2"]}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"x0", "=", 
          RowBox[{"Log", "[", 
           RowBox[{"s0", "+", 
            RowBox[{"sud", 
             RowBox[{"(", 
              RowBox[{
               FractionBox["1", "2"], "-", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"b1", "=", 
          RowBox[{"Log", "[", 
           RowBox[{"s0", "+", 
            RowBox[{"ud", 
             RowBox[{"(", 
              RowBox[{
               FractionBox["1", "2"], "+", "\[Eta]", "+", 
               RowBox[{"(", 
                RowBox[{"k", "-", "1"}], ")"}]}], ")"}], "\[Alpha]"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"b2", "=", 
          RowBox[{"Log", "[", 
           RowBox[{"s0", "-", 
            RowBox[{"ud", 
             RowBox[{"(", 
              RowBox[{
               FractionBox["1", "2"], "+", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"While", "[", 
          RowBox[{
           RowBox[{"pn", ">", "\[Epsilon]"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"n", "++"}], ";", "\[IndentingNewLine]", 
            RowBox[{"yn", "=", 
             RowBox[{
              RowBox[{"+", "ud"}], "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", "*", 
                 RowBox[{"(", 
                  RowBox[{"n", "-", "1"}], ")"}], "*", "b2"}], "-", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", "n"}], "-", "1"}], ")"}], "*", "b1"}], "+", 
                "x0"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"zn", "=", 
             RowBox[{
              RowBox[{"+", "ud"}], "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", "*", "n", "*", "b2"}], "-", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", "n"}], "-", "1"}], ")"}], "*", "b1"}], "-", 
                "x0"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"pn", "=", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 SuperscriptBox["\[ExponentialE]", 
                  RowBox[{
                   FractionBox["\[Omega]", 
                    SuperscriptBox["\[Sigma]", "2"]], "yn"}]], 
                 RowBox[{"ncdf", "[", 
                  FractionBox[
                   RowBox[{"yn", "+", 
                    RowBox[{"\[Omega]", " ", "t"}]}], 
                   RowBox[{"\[Sigma]", 
                    SqrtBox["t"]}]], "]"}]}], "+", 
                RowBox[{
                 SuperscriptBox["\[ExponentialE]", 
                  RowBox[{
                   RowBox[{"-", 
                    FractionBox["\[Omega]", 
                    SuperscriptBox["\[Sigma]", "2"]]}], "yn"}]], 
                 RowBox[{"ncdf", "[", 
                  FractionBox[
                   RowBox[{"yn", "-", 
                    RowBox[{"\[Omega]", " ", "t"}]}], 
                   RowBox[{"\[Sigma]", 
                    SqrtBox["t"]}]], "]"}]}]}], ")"}], "-", 
              "\[IndentingNewLine]", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 SuperscriptBox["\[ExponentialE]", 
                  RowBox[{
                   FractionBox["\[Omega]", 
                    SuperscriptBox["\[Sigma]", "2"]], "zn"}]], 
                 RowBox[{"ncdf", "[", 
                  FractionBox[

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"iterfit", "[", 
    RowBox[{
    "s0_", ",", "\[Alpha]_", ",", "\[Eta]0_", ",", "\[Sigma]0_", ",", 
     "\[Mu]0_", ",", "randomsample_", ",", "nmax_", ",", "step_"}], "]"}], ":=",
    "\[IndentingNewLine]", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ptsCoUp", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"ptsAlDown", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"ptsAlUp", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"ptsCoDown", "=", 
        RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"funcs", "=", 
        RowBox[{"{", "}"}]}], ",", "j", ",", "p", ",", "newrow"}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"For", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"j", "=", "1"}], ",", 
        RowBox[{"j", "\[LessEqual]", "nmax"}], ",", 
        RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"p", "=", 
          RowBox[{
          "randomsample", "\[LeftDoubleBracket]", "j", 
           "\[RightDoubleBracket]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"ptsCoUp", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"ptsCoUp", ",", 
            RowBox[{"tfromp", "[", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1", ",", "s0", ",", "\[Alpha]", ",", 
              "\[Eta]0", ",", "\[Sigma]0", ",", "\[Mu]0", ",", "p"}], "]"}]}],
            "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"ptsCoDown", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"ptsCoDown", ",", 
            RowBox[{"tfromp", "[", 
             RowBox[{"1", ",", 
              RowBox[{"-", "1"}], ",", "s0", ",", "\[Alpha]", ",", "\[Eta]0", 
              ",", "\[Sigma]0", ",", "\[Mu]0", ",", "p"}], "]"}]}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"ptsAlUp", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"ptsAlUp", ",", 
            RowBox[{"tfromp", "[", 
             RowBox[{
             "1", ",", "1", ",", "s0", ",", "\[Alpha]", ",", "\[Eta]0", ",", 
              "\[Sigma]0", ",", "\[Mu]0", ",", "p"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"ptsAlDown", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"ptsAlDown", ",", 
            RowBox[{"tfromp", "[", 
             RowBox[{
              RowBox[{"-", "1"}], ",", 
              RowBox[{"-", "1"}], ",", "s0", ",", "\[Alpha]", ",", "\[Eta]0", 
              ",", "\[Sigma]0", ",", "\[Mu]0", ",", "p"}], "]"}]}], "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Mod", "[", 
             RowBox[{"j", ",", "step"}], "]"}], "\[Equal]", "0"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"newrow", "=", 
             RowBox[{"Prepend", "[", 
              RowBox[{
               RowBox[{"Join", "[", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"Apply", "[", 
                  RowBox[{"List", ",", 
                   RowBox[{"EstimatedDistribution", "[", 
                    RowBox[{"ptsCoUp", ",", 
                    RowBox[{"InverseGaussianDistribution", "[", 
                    RowBox[{"\[Mu]", ",", "\[Lambda]", ",", "\[Theta]"}], 
                    "]"}]}], "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
                 RowBox[{"Apply", "[", 
                  RowBox[{"List", ",", 
                   RowBox[{"EstimatedDistribution", "[", 
                    RowBox[{"ptsCoDown", ",", 
                    RowBox[{"InverseGaussianDistribution", "[", 
                    RowBox[{"\[Mu]", ",", "\[Lambda]", ",", "\[Theta]"}], 
                    "]"}]}], "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
                 RowBox[{"Apply", "[", 
                  RowBox[{"List", ",", 
                   RowBox[{"EstimatedDistribution", "[", 
                    RowBox[{"ptsAlUp", ",", 
                    RowBox[{"InverseGaussianDistribution", "[", 
                    RowBox[{"\[Mu]", ",", "\[Lambda]", ",", "\[Theta]"}], 
                    "]"}]}], "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
                 RowBox[{"Apply", "[", 
                  RowBox[{"List", ",", 
                   RowBox[{"EstimatedDistribution", "[", 
                    RowBox[{"ptsAlDown", ",", 
                    RowBox[{"InverseGaussianDistribution", "[", 
                    RowBox[{"\[Mu]", ",", "\[Lambda]", ",", "\[Theta]"}], 
                    "]"}]}], "]"}]}], "]"}]}], "\[IndentingNewLine]", "]"}], 
               ",", "j"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"Print", "[", "newrow", "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"funcs", "=", 
             RowBox[{"Append", "[", 
              RowBox[{"funcs", ",", "newrow"}], "]"}]}]}]}], "]"}], ";"}]}], 
       "]"}], ";", "\[IndentingNewLine]", "funcs"}]}], "]"}]}], 
  ";"}]], "Input",

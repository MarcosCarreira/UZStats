                RowBox[{"2", "*", "n", "*", "b2"}], "-", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", "n"}], "-", "1"}], ")"}], "*", "b1"}], "-", 
                "x0"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"pn", "=", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 SuperscriptBox["\[ExponentialE]", 
                  RowBox[{
                   FractionBox["\[Omega]", 
                    SuperscriptBox["\[Sigma]", "2"]], "yn"}]], 
                 RowBox[{"ncdf", "[", 
                  FractionBox[
                   RowBox[{"yn", "+", 
                    RowBox[{"\[Omega]", " ", "t"}]}], 
                   RowBox[{"\[Sigma]", 
                    SqrtBox["t"]}]], "]"}]}], "+", 
                RowBox[{
                 SuperscriptBox["\[ExponentialE]", 
                  RowBox[{
                   RowBox[{"-", 
                    FractionBox["\[Omega]", 
                    SuperscriptBox["\[Sigma]", "2"]]}], "yn"}]], 
                 RowBox[{"ncdf", "[", 
                  FractionBox[
                   RowBox[{"yn", "-", 
                    RowBox[{"\[Omega]", " ", "t"}]}], 
                   RowBox[{"\[Sigma]", 
                    SqrtBox["t"]}]], "]"}]}]}], ")"}], "-", 
              "\[IndentingNewLine]", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 SuperscriptBox["\[ExponentialE]", 

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Pt", "[", 
    RowBox[{
    "sud_", ",", "ud_", ",", "s0_", ",", "\[Alpha]_", ",", "\[Eta]_", ",", 
     "\[Sigma]_", ",", "\[Mu]_", ",", "t_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Omega]", ",", "x0", ",", "b1", ",", "b2", ",", "yn", ",", "zn", ",", 
       
       RowBox[{"n", "=", "0"}], ",", 
       RowBox[{"ans", "=", "0"}], ",", 
       RowBox[{"\[Epsilon]", "=", 
        SuperscriptBox["10", 
         RowBox[{"-", "10"}]]}], ",", 
       RowBox[{"pn", "=", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"t", "\[Equal]", "0"}], ",", "0", ",", "\[IndentingNewLine]", 
        
        RowBox[{
         RowBox[{"\[Omega]", "=", 
          RowBox[{"\[Mu]", "-", 
           RowBox[{
            FractionBox["1", "2"], 
            SuperscriptBox["\[Sigma]", "2"]}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"x0", "=", 
          RowBox[{"Log", "[", 
           RowBox[{"s0", "+", 
            RowBox[{"sud", 
             RowBox[{"(", 
              RowBox[{
               FractionBox["1", "2"], "-", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"b1", "=", 
          RowBox[{"Log", "[", 
           RowBox[{"s0", "+", 
            RowBox[{"ud", 
             RowBox[{"(", 
              RowBox[{
               FractionBox["1", "2"], "+", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"b2", "=", 
          RowBox[{"Log", "[", 
           RowBox[{"s0", "-", 
            RowBox[{"ud", 
             RowBox[{"(", 
              RowBox[{
               FractionBox["1", "2"], "+", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"While", "[", 

                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", "n"}], "-", "1"}], ")"}], "*", "b1"}], "+", 
                "x0"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"zn", "=", 

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"intPt", "[", 
    RowBox[{
    "sud_", ",", "ud_", ",", "s0_", ",", "\[Alpha]_", ",", "\[Eta]_", ",", 
     "\[Sigma]_", ",", "\[Mu]_", ",", "tmax_", ",", 
     RowBox[{"dt_", ":", "0.001"}], ",", 
     RowBox[{"all_", ":", "True"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "pinf", ",", "scale", ",", "tblinterp", ",", "trnsp", ",", 
       "tblintegr"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"pinf", "=", 
       RowBox[{"Ptinf", "[", 
        RowBox[{
        "sud", ",", "ud", ",", "s0", ",", "\[Alpha]", ",", "\[Eta]", ",", 
         "\[Sigma]", ",", "\[Mu]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"scale", "=", 
       RowBox[{
        RowBox[{"(", "1", ")"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           FractionBox["\[Alpha]", "s0"], 
           FractionBox["1", "\[Sigma]"]}], ")"}], "2"]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tblinterp", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"t", ",", 
           RowBox[{"dt", "*", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              FractionBox[
               RowBox[{"Pt", "[", 
                RowBox[{
                "sud", ",", "ud", ",", "s0", ",", "\[Alpha]", ",", "\[Eta]", 
                 ",", "\[Sigma]", ",", "\[Mu]", ",", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"t", "+", 
                    RowBox[{"dt", "/", "2"}]}], ")"}], "scale"}]}], "]"}], 
               "pinf"]}], ")"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", 
           RowBox[{"tmax", "-", "dt"}], ",", "dt"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"trnsp", "=", 
       RowBox[{"Transpose", "[", "tblinterp", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tblintegr", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"First", "[", "trnsp", "]"}], ",", 
          RowBox[{"Accumulate", "[", 
           RowBox[{"Last", "[", "trnsp", "]"}], "]"}]}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{"all", ",", "tblintegr", ",", 
        RowBox[{"Last", "[", 
         RowBox[{"Last", "[", "tblintegr", "]"}], "]"}]}], "]"}]}]}], "]"}]}],
   ";"}]], "Input",

Cell[BoxData[
 RowBox[{
  RowBox[{"E", "[", "X", "]"}], "=", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "\[Infinity]"}], "0"], 
     RowBox[{
      RowBox[{"F", "[", "x", "]"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}]}], "+", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", 
     RowBox[{"+", "\[Infinity]"}]], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"F", "[", "x", "]"}]}], ")"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}]}]}]], "DisplayFormula",
 CellChangeTimes->{{3.81252108825316*^9, 3.8125211806213083`*^9}},
 Background->RGBColor[
  1, 1, 0],ExpressionUUID->"3068100b-5609-4e07-b3b9-bba92ede9adb"],


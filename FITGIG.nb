                 RowBox[{"ncdf", "[", 
                  FractionBox[
                   RowBox[{"zn", "-", 
                    RowBox[{"\[Omega]", " ", "t"}]}], 
                   RowBox[{"\[Sigma]", 
                    SqrtBox["t"]}]], "]"}]}]}], ")"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"ans", "+=", "pn"}], ";"}]}], "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         FractionBox["\[Omega]", 
          SuperscriptBox["\[Sigma]", "2"]], 
         RowBox[{"(", 
          RowBox[{"b1", "-", "x0"}], ")"}]}]], "ans"}]}]}], "]"}]}], 

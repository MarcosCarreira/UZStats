Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Alpha]", "=", "0.01"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\[Sigma]", "=", 
      FractionBox["0.01", 
       SqrtBox[
        RowBox[{"24", "*", "3600"}]]]}], ",", "\[IndentingNewLine]", 
     RowBox[{"S", "=", "100"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\[Mu]", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Phi]tup", "[", 
         RowBox[{
          RowBox[{"S", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              FractionBox["1", "2"], "-", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
          ",", 
          RowBox[{"S", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              FractionBox["1", "2"], "+", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
          ",", 
          RowBox[{"S", "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              FractionBox["1", "2"], "+", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
          ",", "\[Sigma]", ",", "t", ",", "\[Mu]", ",", "10000"}], "]"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"{", 

Cell[CellGroupData[{

Cell["3.3.2 Double-barrier densities of first exit times ", "Subsection",
 CellChangeTimes->{{3.765871302430662*^9, 3.765871319224515*^9}, {
  3.7658713529523706`*^9, 3.765871357106618*^9}, {3.7658714043912563`*^9, 
  3.765871455152464*^9}, {3.7662098314082813`*^9, 
  3.766209839741708*^9}},ExpressionUUID->"6e750db9-4c68-4071-b41b-\
28a6d2c4e9f4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        FractionBox["\[Omega]", 
         SuperscriptBox["\[Sigma]", "2"]], 
        RowBox[{"(", 
         RowBox[{"bu", "-", "x0"}], ")"}]}]], "\[IndentingNewLine]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["\[Omega]", 
            SuperscriptBox["\[Sigma]", "2"]], "yn"}]], 
         RowBox[{"NN", "[", 
          FractionBox[
           RowBox[{"yn", "+", 
            RowBox[{"\[Omega]", " ", "t"}]}], 
           RowBox[{"\[Sigma]", 
            SqrtBox["t"]}]], "]"}]}], "+", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["\[Omega]", 
             SuperscriptBox["\[Sigma]", "2"]]}], "yn"}]], 
         RowBox[{"NN", "[", 
          FractionBox[
           RowBox[{"yn", "-", 
            RowBox[{"\[Omega]", " ", "t"}]}], 

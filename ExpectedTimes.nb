      BaselinePosition->Baseline,
      FrameMargins->0,
      ImageSize->Automatic],
     DynamicModuleValues:>{}],
    BaseStyle->"InformationGridFrame",
    StripOnInput->False], "InformationGridPlain",
   StripOnInput->False],
  InformationData[
   Association[
   "ObjectType" -> "Symbol", "Usage" -> "Global`\[Phi]tup", "Documentation" -> 
    None, "OwnValues" -> None, "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, $CellContext`\[Phi]tup, {$CellContext`\[Phi]tup[
         Pattern[$CellContext`S0, 
          Blank[]], 
         Pattern[$CellContext`Bu, 
          Blank[]], 
         Pattern[$CellContext`Bd, 
          Blank[]], 
         Pattern[$CellContext`\[Sigma], 
          Blank[]], 
         Pattern[$CellContext`t, 
          Blank[]], 
         Optional[
          Pattern[$CellContext`\[Mu], 
           Blank[]], 0], 
         Optional[
          Pattern[$CellContext`nmax, 
           Blank[]], 2000]] :> 
       Module[{$CellContext`x0, $CellContext`bu, $CellContext`bd}, 
         If[$CellContext`t == 0, 
          0, $CellContext`x0 = Log[$CellContext`S0]; $CellContext`bu = 
           Log[$CellContext`Bu]; $CellContext`bd = 
           Log[$CellContext`Bd]; $CellContext`yn[
             Pattern[$CellContext`n, 
              Blank[]]] := 
           Plus[1] ((2 ($CellContext`n - 1)) $CellContext`bd - (
              2 $CellContext`n - 
              1) $CellContext`bu + $CellContext`x0); $CellContext`zn[
             Pattern[$CellContext`n, 
              Blank[]]] := 
           Plus[1] ((2 $CellContext`n) $CellContext`bd - (2 $CellContext`n - 
              1) $CellContext`bu - $CellContext`x0); ((
             E^(($CellContext`\[Mu]/$CellContext`\[Sigma]^2) ($CellContext`bu - \
$CellContext`x0)) (
              Sqrt[2 Pi]/$CellContext`t)) \
$CellContext`nn[($CellContext`\[Mu]/$CellContext`\[Sigma] - (1/
                2) $CellContext`\[Sigma]) Sqrt[$CellContext`t]]) Sum[
             
             Quiet[$CellContext`nn[$CellContext`zn[$CellContext`n]/($\
CellContext`\[Sigma] 
                 Sqrt[$CellContext`t])] \
($CellContext`zn[$CellContext`n]/($CellContext`\[Sigma] 
                Sqrt[$CellContext`t])) - \
$CellContext`nn[$CellContext`yn[$CellContext`n]/($CellContext`\[Sigma] 
                Sqrt[$CellContext`t])] \
($CellContext`yn[$CellContext`n]/($CellContext`\[Sigma] 
               Sqrt[$CellContext`t]))], {$CellContext`n, 
              1, $CellContext`nmax}]]]}], "SubValues" -> None, 
    "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> None, "Attributes" -> {}, "FullName" -> "Global`\[Phi]tup"], 
   False]]], "Output",

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fstatstm", "[", 
    RowBox[{
    "S_", ",", "\[Alpha]_", ",", "\[Sigma]_", ",", "\[Mu]_", ",", "\[Eta]_", 
     ",", 
     RowBox[{"nmax_", ":", "1000"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"probs", ",", "eta"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"probs", "=", 
       RowBox[{"stattm", "[", 
        RowBox[{
        "S", ",", "\[Alpha]", ",", "\[Sigma]", ",", "\[Mu]", ",", "\[Eta]", 
         ",", "nmax"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"eta", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
          "probs", "\[LeftDoubleBracket]", "5", "\[RightDoubleBracket]"}], 
          "+", 
          RowBox[{
          "probs", "\[LeftDoubleBracket]", "6", "\[RightDoubleBracket]"}]}], 
         ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
            "probs", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 

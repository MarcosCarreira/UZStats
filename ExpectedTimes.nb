   RowBox[{"getdmp", "[", 
    RowBox[{
    "S_", ",", "\[Alpha]_", ",", "\[Sigma]_", ",", "\[Mu]_", ",", "\[Eta]_", 
     ",", 
     RowBox[{"nmax_", ":", "1000"}]}], "]"}], ":=", 

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"draw", "[", 
    RowBox[{"function_", ",", "prevpts_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bounds", ",", "rnds", ",", "pts"}], "}"}], ",", 
     "\[IndentingNewLine]", 

                    FractionBox[
                    RowBox[{"znu", "-", 
                    RowBox[{"\[Omega]", " ", "t"}]}], 
                    RowBox[{"\[Sigma]", 
                    SqrtBox["t"]}]], "]"}]}]}], ")"}]}], ")"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"pnad", "=", "\[IndentingNewLine]", 
             RowBox[{
              SuperscriptBox["\[ExponentialE]", 
               RowBox[{
                FractionBox["\[Omega]", 

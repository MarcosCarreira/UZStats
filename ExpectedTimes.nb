                ",", "tpcup", ",", "ptaup", ",", "tpaup", ",", "ptcdown", ",",
                 "tpcdown", ",", "ptadown", ",", "tpadown"}], "}"}]}], "]"}], 
            "&"}], ",", "init", ",", "lpath"}], "]"}], ",", 
         RowBox[{"{", "npaths", "}"}]}], "]"}], "\[IndentingNewLine]", "*)"}],
       "\[IndentingNewLine]", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"NestWhileList", "[", 

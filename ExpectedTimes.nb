Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]tdown", "[", 
    RowBox[{"S0_", ",", "Bu_", ",", "Bd_", ",", "\[Sigma]_", ",", "t_", ",", 
     RowBox[{"\[Mu]_", ":", "0"}], ",", 
     RowBox[{"nmax_", ":", "nmaxd"}]}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x0", ",", "bu", ",", "bd"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"t", "\[Equal]", "0"}], ",", "0", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"x0", "=", 
         RowBox[{"Log", "[", "S0", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"bu", "=", 
         RowBox[{"Log", "[", "Bu", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"bd", "=", 
         RowBox[{"Log", "[", "Bd", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"yn", "[", "n_", "]"}], ":=", 
         RowBox[{
          RowBox[{"-", "1"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", 
             RowBox[{"(", 
              RowBox[{"n", "-", "1"}], ")"}], "*", "bu"}], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", "n"}], "-", "1"}], ")"}], "*", "bd"}], "+", 
            "x0"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"zn", "[", "n_", "]"}], ":=", 
         RowBox[{
          RowBox[{"-", "1"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", "n", "*", "bu"}], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", "n"}], "-", "1"}], ")"}], "*", "bd"}], "-", 
            "x0"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["\[Mu]", 
            SuperscriptBox["\[Sigma]", "2"]], 
           RowBox[{"(", 
            RowBox[{"bd", "-", "x0"}], ")"}]}]], 
         FractionBox[
          SqrtBox[
           RowBox[{"2", "\[Pi]"}]], "t"], 
         RowBox[{"nn", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             FractionBox["\[Mu]", "\[Sigma]"], "-", 
             RowBox[{
              FractionBox["1", "2"], "\[Sigma]"}]}], ")"}], 
           SqrtBox["t"]}], "]"}], 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"Quiet", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"nn", "[", 
               FractionBox[
                RowBox[{"zn", "[", "n", "]"}], 
                RowBox[{"\[Sigma]", 
                 SqrtBox["t"]}]], "]"}], 
              RowBox[{"(", 
               FractionBox[
                RowBox[{"zn", "[", "n", "]"}], 
                RowBox[{"\[Sigma]", 
                 SqrtBox["t"]}]], ")"}]}], "-", 
             RowBox[{
              RowBox[{"nn", "[", 
               FractionBox[
                RowBox[{"yn", "[", "n", "]"}], 
                RowBox[{"\[Sigma]", 
                 SqrtBox["t"]}]], "]"}], 
              RowBox[{"(", 
               FractionBox[
                RowBox[{"yn", "[", "n", "]"}], 
                RowBox[{"\[Sigma]", 
                 SqrtBox["t"]}]], ")"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", "nmax"}], "}"}]}], "]"}]}]}]}], 
      "]"}]}], "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.786315825008114*^9, 3.786315830157145*^9}, {

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Ptdown", "[", 
    RowBox[{"S0_", ",", "Bu_", ",", "Bd_", ",", "\[Sigma]_", ",", "t_", ",", 
     RowBox[{"\[Mu]_", ":", "0"}], ",", 
     RowBox[{"nmax_", ":", "nmaxd"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Omega]", ",", "x0", ",", "bu", ",", "bd"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"t", "\[Equal]", "0"}], ",", "0", ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Omega]", "=", 
         RowBox[{"\[Mu]", "-", 
          RowBox[{
           FractionBox["1", "2"], 
           SuperscriptBox["\[Sigma]", "2"]}]}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"x0", "=", 
         RowBox[{"Log", "[", "S0", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"bu", "=", 
         RowBox[{"Log", "[", "Bu", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"bd", "=", 
         RowBox[{"Log", "[", "Bd", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"yn", "[", "n_", "]"}], ":=", 
         RowBox[{
          RowBox[{"-", "1"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", 
             RowBox[{"(", 
              RowBox[{"n", "-", "1"}], ")"}], "*", "bu"}], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", "n"}], "-", "1"}], ")"}], "*", "bd"}], "+", 
            "x0"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"zn", "[", "n_", "]"}], ":=", 
         RowBox[{
          RowBox[{"-", "1"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "*", "n", "*", "bu"}], "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", "n"}], "-", "1"}], ")"}], "*", "bd"}], "-", 
            "x0"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["\[Omega]", 
            SuperscriptBox["\[Sigma]", "2"]], 
           RowBox[{"(", 
            RowBox[{"bd", "-", "x0"}], ")"}]}]], 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"Quiet", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                SuperscriptBox["\[ExponentialE]", 
                 RowBox[{
                  FractionBox["\[Omega]", 
                   SuperscriptBox["\[Sigma]", "2"]], 
                  RowBox[{"yn", "[", "n", "]"}]}]], 
                RowBox[{"NN", "[", 
                 FractionBox[
                  RowBox[{
                   RowBox[{"yn", "[", "n", "]"}], "+", 
                   RowBox[{"\[Omega]", " ", "t"}]}], 
                  RowBox[{"\[Sigma]", 
                   SqrtBox["t"]}]], "]"}]}], "+", 
               RowBox[{
                SuperscriptBox["\[ExponentialE]", 
                 RowBox[{
                  RowBox[{"-", 
                   FractionBox["\[Omega]", 
                    SuperscriptBox["\[Sigma]", "2"]]}], 
                  RowBox[{"yn", "[", "n", "]"}]}]], 
                RowBox[{"NN", "[", 
                 FractionBox[
                  RowBox[{
                   RowBox[{"yn", "[", "n", "]"}], "-", 
                   RowBox[{"\[Omega]", " ", "t"}]}], 
                  RowBox[{"\[Sigma]", 
                   SqrtBox["t"]}]], "]"}]}]}], ")"}], "-", 
             "\[IndentingNewLine]", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                SuperscriptBox["\[ExponentialE]", 
                 RowBox[{
                  FractionBox["\[Omega]", 
                   SuperscriptBox["\[Sigma]", "2"]], 
                  RowBox[{"zn", "[", "n", "]"}]}]], 
                RowBox[{"NN", "[", 
                 FractionBox[
                  RowBox[{
                   RowBox[{"zn", "[", "n", "]"}], "+", 
                   RowBox[{"\[Omega]", " ", "t"}]}], 
                  RowBox[{"\[Sigma]", 
                   SqrtBox["t"]}]], "]"}]}], "+", 

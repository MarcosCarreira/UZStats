Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"draw", "[", 
    RowBox[{"function_", ",", "prevpts_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bounds", ",", "rnds", ",", "pts"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"bounds", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"Max", "[", 
          RowBox[{"Map", "[", 
           RowBox[{"First", ",", "prevpts"}], "]"}], "]"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"rnds", "=", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"bounds", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"pts", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"Join", "[", 
         RowBox[{"prevpts", ",", 
          RowBox[{"ParallelMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"#", ",", 
               RowBox[{"function", "[", "#", "]"}]}], "}"}], "&"}], ",", 
            "rnds"}], "]"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 

                  RowBox[{
                   SuperscriptBox["\[ExponentialE]", 
                    RowBox[{
                    FractionBox["\[Omega]", 
                    SuperscriptBox["\[Sigma]", "2"]], "znu"}]], 
                   RowBox[{"ncdf", "[", 
                    FractionBox[
                    RowBox[{"znu", "+", 
                    RowBox[{"\[Omega]", " ", "t"}]}], 
                    RowBox[{"\[Sigma]", 
                    SqrtBox["t"]}]], "]"}]}], "+", 

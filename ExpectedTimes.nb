Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Alpha]", "=", "0.01"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\[Sigma]", "=", "0.01"}], ",", "\[IndentingNewLine]", 
     RowBox[{"S", "=", "100"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\[Eta]", "=", "0.5"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\[Mu]", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"DiscretePlot", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Phi]tup", "[", 
        RowBox[{
         RowBox[{"S", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             FractionBox["1", "2"], "-", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
         ",", 
         RowBox[{"S", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             FractionBox["1", "2"], "+", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
         ",", 
         RowBox[{"S", "-", 
          RowBox[{
           RowBox[{"(", 

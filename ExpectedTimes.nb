             FractionBox["1", "2"], "+", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
         ",", "\[Sigma]", ",", "1", ",", "\[Mu]", ",", "nmax"}], "]"}]}], ";",
       "\[IndentingNewLine]", 

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"stattm", "[", 
    RowBox[{
    "S_", ",", "\[Alpha]_", ",", "\[Sigma]_", ",", "\[Mu]_", ",", "\[Eta]_", 
     ",", 
     RowBox[{"nmax_", ":", "1000"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "init", ",", "pup0", ",", "pupA", ",", "pdownA", ",", "tmat", ",", 
       "proc", ",", "probs"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"pup0", "=", 
       RowBox[{"Ptup", "[", 
        RowBox[{"S", ",", 
         RowBox[{"S", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             FractionBox["1", "2"], "+", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
         ",", 
         RowBox[{"S", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             FractionBox["1", "2"], "+", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
         ",", "\[Sigma]", ",", "1", ",", "\[Mu]", ",", "nmax"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"init", "=", 
       RowBox[{"{", 
        RowBox[{"pup0", ",", 
         RowBox[{"1", "-", "pup0"}], ",", "0", ",", "0", ",", "0", ",", "0"}],
         "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"Grid", "[", 
          RowBox[{
           RowBox[{"{", "init", "}"}], ",", 
           RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}], "]"}], ";"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"pupA", "=", 
       RowBox[{"Ptup", "[", 
        RowBox[{
         RowBox[{"S", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             FractionBox["1", "2"], "-", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
         ",", 
         RowBox[{"S", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             FractionBox["1", "2"], "+", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
         ",", 
         RowBox[{"S", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             FractionBox["1", "2"], "+", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
         ",", "\[Sigma]", ",", "1", ",", "\[Mu]", ",", "nmax"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"pdownA", "=", 
       RowBox[{"Ptdown", "[", 
        RowBox[{
         RowBox[{"S", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             FractionBox["1", "2"], "-", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
         ",", 
         RowBox[{"S", "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             FractionBox["1", "2"], "+", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
         ",", 
         RowBox[{"S", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             FractionBox["1", "2"], "+", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
         ",", "\[Sigma]", ",", "1", ",", "\[Mu]", ",", "nmax"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"tmat", "=", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0", ",", "pdownA", ",", 
           RowBox[{"1", "-", "pdownA"}], ",", "0"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "pupA", ",", "0", ",", "0", ",", 
           RowBox[{"1", "-", "pupA"}]}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
          "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1", ",", "0", ",", "0", ",", "0", ",", "0"}], 
          "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
          "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1", ",", "0", ",", "0", ",", "0", ",", "0"}], 
          "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"Grid", "[", 
          RowBox[{"tmat", ",", 
           RowBox[{"Frame", "\[Rule]", "True"}]}], "]"}], "]"}], ";"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"proc", "=", 
       RowBox[{"DiscreteMarkovProcess", "[", 
        RowBox[{"init", ",", "tmat"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"probs", "=", 
       RowBox[{"Chop", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"PDF", "[", 
           RowBox[{
            RowBox[{"StationaryDistribution", "[", "proc", "]"}], ",", "j"}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", "init", "]"}]}], "}"}]}], "]"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"StringJoin", "[", 
          RowBox[{"\"\<eta = \>\"", ",", 
           RowBox[{"ToString", "[", 

          RowBox[{
           RowBox[{"nextinpath", "[", 
            RowBox[{"#", ",", 
             RowBox[{"{", 
              RowBox[{
              "S", ",", "\[Alpha]", ",", "\[Eta]", ",", "\[Epsilon]"}], "}"}],
              ",", 

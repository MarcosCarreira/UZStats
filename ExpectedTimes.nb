Cell[BoxData[
 InterpretationBox[
  StyleBox[
   FrameBox[
    DynamicModuleBox[{System`InformationDump`open$$ = True, 
     System`InformationDump`mouseOver$$ = False}, 
     PaneSelectorBox[{True->
      TagBox[GridBox[{
         {
          ItemBox[
           PaneBox[
            StyleBox["\<\" Symbol\"\>", "InformationTitleText",
             StripOnInput->False,
             BaseStyle -> None],
            FrameMargins->{{4, 0}, {-1, 1}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            StyleBox["\<\"Global`\[Phi]tup\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False]},
         {
          PaneBox[GridBox[{
             {
              
              DynamicModuleBox[{System`InformationDump`open$$ = {
               False, False, False, False, False, False, False, False, False, 
                False, False, False}}, 
               StyleBox[GridBox[{
                  {
                   TagBox[
                    TooltipBox[
                    StyleBox["\<\" Definitions\"\>", "InformationRowLabel",
                    StripOnInput->False],
                    "\"Definitions\"",
                    TooltipStyle->"TextStyling"],
                    Annotation[#, "Definitions", "Tooltip"]& ], GridBox[{
                    {
                    RowBox[{
                    RowBox[{"\[Phi]tup", "[", 
                    RowBox[{
                    "S0_", ",", "Bu_", ",", "Bd_", ",", "\[Sigma]_", ",", 
                    "t_", ",", 
                    RowBox[{"\[Mu]_", ":", "0"}], ",", 
                    RowBox[{"nmax_", ":", "2000"}]}], "]"}], ":=", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"x0", ",", "bu", ",", "bd"}], "}"}], ",", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"t", "\[Equal]", "0"}], ",", "0", ",", 
                    RowBox[{
                    RowBox[{"x0", "=", 
                    RowBox[{"Log", "[", "S0", "]"}]}], ";", 
                    RowBox[{"bu", "=", 
                    RowBox[{"Log", "[", "Bu", "]"}]}], ";", 
                    RowBox[{"bd", "=", 
                    RowBox[{"Log", "[", "Bd", "]"}]}], ";", 
                    RowBox[{
                    RowBox[{"yn", "[", "n_", "]"}], ":=", 
                    RowBox[{
                    RowBox[{"+", "1"}], " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2", " ", 
                    RowBox[{"(", 
                    RowBox[{"n", "-", "1"}], ")"}], " ", "bd"}], "-", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2", " ", "n"}], "-", "1"}], ")"}], " ", "bu"}], 
                    "+", "x0"}], ")"}]}]}], ";", 
                    RowBox[{
                    RowBox[{"zn", "[", "n_", "]"}], ":=", 
                    RowBox[{
                    RowBox[{"+", "1"}], " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2", " ", "n", " ", "bd"}], "-", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"2", " ", "n"}], "-", "1"}], ")"}], " ", "bu"}], 
                    "-", "x0"}], ")"}]}]}], ";", 
                    FractionBox[
                    RowBox[{
                    SuperscriptBox["\[ExponentialE]", 
                    FractionBox[
                    RowBox[{"\[Mu]", " ", 
                    RowBox[{"(", 
                    RowBox[{"bu", "-", "x0"}], ")"}]}], 
                    SuperscriptBox["\[Sigma]", "2"]]], " ", 
                    SqrtBox[
                    RowBox[{"2", " ", "\[Pi]"}]], " ", 
                    RowBox[{"nn", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    FractionBox["\[Mu]", "\[Sigma]"], "-", 
                    FractionBox["\[Sigma]", "2"]}], ")"}], " ", 
                    SqrtBox["t"]}], "]"}], " ", 
                    RowBox[{
                    UnderoverscriptBox["\[Sum]", 
                    RowBox[{"n", "=", "1"}], "nmax"], 
                    RowBox[{"Quiet", "[", 
                    RowBox[{
                    FractionBox[
                    RowBox[{
                    RowBox[{"nn", "[", 
                    FractionBox[
                    RowBox[{"zn", "[", "n", "]"}], 
                    RowBox[{"\[Sigma]", " ", 
                    SqrtBox["t"]}]], "]"}], " ", 
                    RowBox[{"zn", "[", "n", "]"}]}], 
                    RowBox[{"\[Sigma]", " ", 
                    SqrtBox["t"]}]], "-", 
                    FractionBox[
                    RowBox[{
                    RowBox[{"nn", "[", 
                    FractionBox[
                    RowBox[{"yn", "[", "n", "]"}], 
                    RowBox[{"\[Sigma]", " ", 
                    SqrtBox["t"]}]], "]"}], " ", 
                    RowBox[{"yn", "[", "n", "]"}]}], 
                    RowBox[{"\[Sigma]", " ", 
                    SqrtBox["t"]}]]}], "]"}]}]}], "t"]}]}], "]"}]}], "]"}]}]}
                    },
                    DefaultBaseStyle->"Column",
                    GridBoxAlignment->{"Columns" -> {{Left}}},
                    
                    GridBoxItemSize->{
                    "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]},

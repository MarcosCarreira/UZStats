Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"buildtables", "[", 
    RowBox[{"data_", ",", 
     RowBox[{"legends_", ":", "True"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Eta]s", "=", 
        RowBox[{
        "data", "\[LeftDoubleBracket]", "6", "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{"ps", "=", 
        RowBox[{
        "data", "\[LeftDoubleBracket]", "10", "\[RightDoubleBracket]"}]}], 
       ",", 
       RowBox[{"bs", "=", 
        RowBox[{
        "data", "\[LeftDoubleBracket]", "11", "\[RightDoubleBracket]"}]}], 
       ",", 
       RowBox[{"scales", "=", 
        RowBox[{
        "data", "\[LeftDoubleBracket]", "12", "\[RightDoubleBracket]"}]}], 
       ",", 
       RowBox[{"adjs", "=", 
        RowBox[{
        "data", "\[LeftDoubleBracket]", "13", "\[RightDoubleBracket]"}]}], 
       ",", 
       RowBox[{"scaleadjs", "=", 
        RowBox[{
        "data", "\[LeftDoubleBracket]", "14", "\[RightDoubleBracket]"}]}], 
       ",", 
       RowBox[{"mean", "=", 
        RowBox[{
        "data", "\[LeftDoubleBracket]", "15", "\[RightDoubleBracket]"}]}], 
       ",", 
       RowBox[{"adjmean", "=", 
        RowBox[{
        "data", "\[LeftDoubleBracket]", "16", "\[RightDoubleBracket]"}]}], 
       ",", "\[IndentingNewLine]", "\[Theta]s", ",", "\[Lambda]s", ",", 
       "\[Mu]s", ",", "p", ",", "b", ",", "scaleadj", ",", "\[Theta]", ",", 
       "\[Lambda]", ",", "\[Mu]", ",", "am"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Theta]s", "=", "ps"}], ";", 
      RowBox[{"\[Lambda]s", "=", 
       RowBox[{"bs", " ", "scales"}]}], ";", 
      RowBox[{"\[Mu]s", "=", "scales"}], ";", "\[IndentingNewLine]", 
      RowBox[{"p", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"\[Eta]s", ",", "ps"}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"b", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"\[Eta]s", ",", "bs"}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"scaleadj", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"\[Eta]s", ",", "scaleadjs"}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Theta]", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"\[Eta]s", ",", "\[Theta]s"}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Lambda]", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"\[Eta]s", ",", "\[Lambda]s"}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"\[Mu]", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"\[Eta]s", ",", "\[Mu]s"}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"am", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"\[Eta]s", ",", "adjmean"}], "}"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p", ",", "b", ",", "scaleadj", ",", "am"}], "}"}], ",", 
        RowBox[{"Frame", "\[Rule]", "True"}], ",", 
        RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "Large"}], ",", 
        RowBox[{"PlotLegends", "\[Rule]", 
         RowBox[{"If", "[", 
          RowBox[{"legends", ",", 
           RowBox[{"{", 
            RowBox[{
            "\"\<p\>\"", ",", " ", "\"\<b\>\"", ",", " ", "\"\<scale_adj\>\"",
              ",", " ", "\"\<adj_mean\>\""}], "}"}], ",", "None"}], "]"}]}]}],
        "]"}]}]}], "]"}]}], ";"}]], "Input",

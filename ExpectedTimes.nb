            RowBox[{
             SubscriptBox["S", "0"], 
             SubscriptBox["B", "\[PlusMinus]"]}]], ")"}], 
          RowBox[{"\[MinusPlus]", 
           FractionBox["\[Omega]", 
            SuperscriptBox["\[Sigma]", "2"]]}]], 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            SubscriptBox["B", "\[MinusPlus]"], 

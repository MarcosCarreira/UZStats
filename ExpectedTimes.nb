Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"S", "=", "100"}], ",", 
     RowBox[{"\[Alpha]", "=", "0.01"}], ",", 
     RowBox[{"\[Sigma]", "=", "0.01"}], ",", 
     RowBox[{"t", "=", "0.002"}], ",", 
     RowBox[{"\[Mu]", "=", 
      RowBox[{"+", "5"}]}]}], "}"}], ",", 
   RowBox[{"DiscretePlot", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"condduralt", "[", 
         RowBox[{
          RowBox[{"S", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              FractionBox["1", "2"], "-", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
          ",", 
          RowBox[{"S", "-", 
           RowBox[{

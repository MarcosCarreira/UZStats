Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"multloglikel", "[", 
    RowBox[{"pw_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"N", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"Factorial", "[", 
        RowBox[{"Total", "[", "x", "]"}], "]"}], "]"}], ",", " ", 
      RowBox[{"Log", "[", 
       RowBox[{"Apply", "[", 
        RowBox[{"Times", ",", 
         RowBox[{"Map", "[", 
          RowBox[{"Factorial", ",", "x"}], "]"}]}], "]"}], "]"}], ",", " ", 
      RowBox[{"Log", "[", 
       RowBox[{"Apply", "[", 
        RowBox[{"Times", ",", 
         RowBox[{"MapThread", "[", 
          RowBox[{"Power", ",", 
           RowBox[{"{", 
            RowBox[{"pw", ",", "x"}], "}"}]}], "]"}]}], "]"}], "]"}]}], "}"}],
     "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.8121249128814774`*^9, 3.81212494229255*^9}, {
  3.8121250193434973`*^9, 3.8121250827240467`*^9}, {3.812125139479952*^9, 

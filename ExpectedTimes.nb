                    FractionBox[
                    RowBox[{"ynu", "-", 
                    RowBox[{"\[Omega]", " ", "t"}]}], 
                    RowBox[{"\[Sigma]", 
                    SqrtBox["t"]}]], "]"}]}]}], ")"}], "-", 
                "\[IndentingNewLine]", 
                RowBox[{"(", 

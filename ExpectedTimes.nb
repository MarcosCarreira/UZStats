Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["\[Phi]", "\[PlusMinus]"], "[", 
   RowBox[{"x", ",", "t"}], "]"}], ":=", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      SubscriptBox["B", "\[PlusMinus]"], 
      SubscriptBox["S", "0"]], ")"}], 
    FractionBox["\[Omega]", 
     SuperscriptBox["\[Sigma]", "2"]]], 
   RowBox[{"(", 
    FractionBox["1", 
     RowBox[{"2", "t"}]], ")"}], 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "1"}], "\[Infinity]"], 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            SubscriptBox["S", "0"], 
            SubscriptBox["B", "\[PlusMinus]"]], ")"}], 
          RowBox[{"\[PlusMinus]", 
           FractionBox["\[Omega]", 
            SuperscriptBox["\[Sigma]", "2"]]}]], 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            SubscriptBox["B", "\[MinusPlus]"], 
            SubscriptBox["B", "\[PlusMinus]"]], ")"}], 
          RowBox[{
           RowBox[{"\[PlusMinus]", "2"}], 
           RowBox[{"(", 
            RowBox[{"n", "-", "1"}], ")"}], 
           FractionBox["\[Omega]", 
            SuperscriptBox["\[Sigma]", "2"]]}]], 
         RowBox[{"\[ScriptN]", "[", 
          FractionBox[
           RowBox[{
            SuperscriptBox[
             SubscriptBox["y", "n"], "\[PlusMinus]"], "+", 
            RowBox[{"\[Omega]", " ", "t"}]}], 
           RowBox[{"\[Sigma]", 
            SqrtBox["t"]}]], "]"}], 
         RowBox[{"(", 
          FractionBox[
           RowBox[{
            RowBox[{"-", 
             SuperscriptBox[
              SubscriptBox["y", "n"], "\[PlusMinus]"]}], "+", 
            RowBox[{"\[Omega]", " ", "t"}]}], 
           RowBox[{"\[Sigma]", 
            SqrtBox["t"]}]], ")"}]}], "-", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            SubscriptBox["S", "0"], 
            SubscriptBox["B", "\[PlusMinus]"]], ")"}], 
          RowBox[{"\[MinusPlus]", 
           FractionBox["\[Omega]", 
            SuperscriptBox["\[Sigma]", "2"]]}]], 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            SubscriptBox["B", "\[MinusPlus]"], 
            SubscriptBox["B", "\[PlusMinus]"]], ")"}], 
          RowBox[{
           RowBox[{"\[MinusPlus]", "2"}], 
           RowBox[{"(", 
            RowBox[{"n", "-", "1"}], ")"}], 
           FractionBox["\[Omega]", 
            SuperscriptBox["\[Sigma]", "2"]]}]], 
         RowBox[{"\[ScriptN]", "[", 
          FractionBox[
           RowBox[{
            SuperscriptBox[
             SubscriptBox["y", "n"], "\[PlusMinus]"], "-", 
            RowBox[{"\[Omega]", " ", "t"}]}], 
           RowBox[{"\[Sigma]", 
            SqrtBox["t"]}]], "]"}], 
         RowBox[{"(", 
          FractionBox[
           RowBox[{
            SuperscriptBox[
             SubscriptBox["y", "n"], "\[PlusMinus]"], "+", 
            RowBox[{"\[Omega]", " ", "t"}]}], 
           RowBox[{"\[Sigma]", 
            SqrtBox["t"]}]], ")"}]}]}], ")"}], "-", "\[IndentingNewLine]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            SuperscriptBox[
             SubscriptBox["B", "\[MinusPlus]"], "2"], 
            RowBox[{
             SubscriptBox["S", "0"], 
             SubscriptBox["B", "\[PlusMinus]"]}]], ")"}], 
          RowBox[{"\[PlusMinus]", 
           FractionBox["\[Omega]", 
            SuperscriptBox["\[Sigma]", "2"]]}]], 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            SubscriptBox["B", "\[MinusPlus]"], 
            SubscriptBox["B", "\[PlusMinus]"]], ")"}], 
          RowBox[{
           RowBox[{"\[PlusMinus]", "2"}], 
           RowBox[{"(", 
            RowBox[{"n", "-", "1"}], ")"}], 
           FractionBox["\[Omega]", 
            SuperscriptBox["\[Sigma]", "2"]]}]], 
         RowBox[{"\[ScriptN]", "[", 
          FractionBox[
           RowBox[{
            SuperscriptBox[
             SubscriptBox["z", "n"], "\[PlusMinus]"], "+", 
            RowBox[{"\[Omega]", " ", "t"}]}], 
           RowBox[{"\[Sigma]", 
            SqrtBox["t"]}]], "]"}], 
         RowBox[{"(", 
          FractionBox[
           RowBox[{
            RowBox[{"-", 
             SuperscriptBox[
              SubscriptBox["z", "n"], "\[PlusMinus]"]}], "+", 
            RowBox[{"\[Omega]", " ", "t"}]}], 
           RowBox[{"\[Sigma]", 
            SqrtBox["t"]}]], ")"}]}], "-", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            SuperscriptBox[
             SubscriptBox["B", "\[MinusPlus]"], "2"], 
            RowBox[{
             SubscriptBox["S", "0"], 
             SubscriptBox["B", "\[PlusMinus]"]}]], ")"}], 
          RowBox[{"\[MinusPlus]", 
           FractionBox["\[Omega]", 
            SuperscriptBox["\[Sigma]", "2"]]}]], 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox[
            SubscriptBox["B", "\[MinusPlus]"], 
            SubscriptBox["B", "\[PlusMinus]"]], ")"}], 
          RowBox[{
           RowBox[{"\[MinusPlus]", "2"}], 
           RowBox[{"(", 

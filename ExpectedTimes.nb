         ",", "\[Sigma]", ",", "1", ",", "\[Mu]", ",", "nmax"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"tmat", "=", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0", ",", "pdownA", ",", 

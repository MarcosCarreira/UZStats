Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fpath", "[", 
    RowBox[{
    "S_", ",", "\[Alpha]_", ",", "\[Sigma]_", ",", "\[Omega]_", ",", 
     "\[Eta]_", ",", 
     RowBox[{"lpath_", ":", "50"}], ",", 
     RowBox[{"npaths_", ":", "1"}], ",", 
     RowBox[{"nrnd_", ":", "20"}], ",", 
     RowBox[{"\[Epsilon]_", ":", "0.01"}], ",", 
     RowBox[{"nmax_", ":", "200"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "ptp0", ",", "tpp0", ",", "ptn0", ",", "tpn0", ",", "ptcup", ",", 
       "tpcup", ",", "\[IndentingNewLine]", "ptaup", ",", "tpaup", ",", 
       "ptcdown", ",", "tpcdown", ",", "ptadown", ",", "tpadown", ",", 
       "init"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Print", "[", 

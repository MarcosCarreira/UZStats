             RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
            RowBox[{"And", "[", 
             RowBox[{
              RowBox[{"i", "\[LessEqual]", "3"}], ",", 
              RowBox[{"4", "\[LessEqual]", "j", "\[LessEqual]", "5"}]}], 
             "]"}]}], "\[Rule]", "1"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i_", ",", "j_"}], "}"}], "/;", 
            RowBox[{"And", "[", 
             RowBox[{
              RowBox[{"i", "\[GreaterEqual]", "4"}], ",", 
              RowBox[{"Or", "[", 
               RowBox[{
                RowBox[{"j", "\[Equal]", 
                 RowBox[{
                  RowBox[{"4", 
                   RowBox[{"Quotient", "[", 
                    RowBox[{"i", ",", "4"}], "]"}]}], "-", "2", "+", 
                  RowBox[{"Boole", "[", 
                   RowBox[{"OddQ", "[", "i", "]"}], "]"}]}]}], ",", 
                RowBox[{"j", "\[Equal]", 
                 RowBox[{
                  RowBox[{"4", 

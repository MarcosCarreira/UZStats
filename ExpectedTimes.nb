               RowBox[{
               "probs", "\[LeftDoubleBracket]", "6", 
                "\[RightDoubleBracket]"}]}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"2", "*", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                 "probs", "\[LeftDoubleBracket]", "3", 
                  "\[RightDoubleBracket]"}], "+", 
                 RowBox[{
                 "probs", "\[LeftDoubleBracket]", "4", 
                  "\[RightDoubleBracket]"}]}], ")"}]}], ")"}]}], "]"}]}], 
          "]"}], "]"}], ";"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"2", "*", "probs"}]}]}], "\[IndentingNewLine]", "]"}]}], 

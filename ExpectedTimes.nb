        RowBox[{
        "S", ",", "\[Alpha]", ",", "\[Sigma]", ",", "\[Omega]", ",", "\[Eta]",
          ",", "lpath", ",", "npaths", ",", "nrnd", ",", "\[Epsilon]", ",", 
         "nmax"}], "}"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"ptp0", "=", 
       RowBox[{"PTUp0", "[", 
        RowBox[{
        "S", ",", "\[Alpha]", ",", "\[Eta]", ",", "\[Sigma]", ",", "\[Omega]",
          ",", "nmax"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ptn0", "=", 
       RowBox[{"1", "-", "ptp0"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ptcup", "=", 
       RowBox[{"PTCUp", "[", 
        RowBox[{
        "S", ",", "\[Alpha]", ",", "\[Eta]", ",", "\[Sigma]", ",", "\[Omega]",
          ",", "nmax"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ptaup", "=", 

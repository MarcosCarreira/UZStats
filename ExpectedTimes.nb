                RowBox[{"yn", "[", "n", "]"}], 
                RowBox[{"\[Sigma]", 
                 SqrtBox["t"]}]], "]"}], 
              RowBox[{"(", 
               FractionBox[
                RowBox[{"yn", "[", "n", "]"}], 
                RowBox[{"\[Sigma]", 
                 SqrtBox["t"]}]], ")"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", "nmax"}], "}"}]}], "]"}]}]}]}], 
      "]"}]}], "]"}]}], ";"}]], "Input",

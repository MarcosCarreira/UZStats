Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"PTset", "[", 
    RowBox[{
    "S_", ",", "\[Alpha]_", ",", "\[Eta]_", ",", "\[Sigma]_", ",", "\[Mu]_", 
     ",", "t_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Omega]", ",", "x0u", ",", "x0d", ",", "bu", ",", "bd", ",", "ynu", 
       ",", "znu", ",", "ynd", ",", "znd", ",", 
       RowBox[{"n", "=", "0"}], ",", 
       RowBox[{"ansau", "=", "0"}], ",", 
       RowBox[{"ansad", "=", "0"}], ",", 
       RowBox[{"\[Epsilon]", "=", 
        SuperscriptBox["10", 
         RowBox[{"-", "10"}]]}], ",", 
       RowBox[{"pnau", "=", "1"}], ",", 
       RowBox[{"pnad", "=", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"t", "\[Equal]", "0"}], ",", "0", ",", "\[IndentingNewLine]", 
        
        RowBox[{
         RowBox[{"\[Omega]", "=", 
          RowBox[{"\[Mu]", "-", 
           RowBox[{
            FractionBox["1", "2"], 
            SuperscriptBox["\[Sigma]", "2"]}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"x0u", "=", 
          RowBox[{"Log", "[", 
           RowBox[{"S", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               FractionBox["1", "2"], "-", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"x0d", "=", 
          RowBox[{"Log", "[", 
           RowBox[{"S", "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               FractionBox["1", "2"], "-", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"bu", "=", 
          RowBox[{"Log", "[", 
           RowBox[{"S", "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               FractionBox["1", "2"], "+", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"bd", "=", 
          RowBox[{"Log", "[", 
           RowBox[{"S", "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               FractionBox["1", "2"], "+", "\[Eta]"}], ")"}], "\[Alpha]"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"While", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"pnau", ",", "pnad"}], "]"}], ">", "\[Epsilon]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"n", "++"}], ";", "\[IndentingNewLine]", 
            RowBox[{"ynu", "=", 
             RowBox[{
              RowBox[{"+", "1"}], "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", "*", 
                 RowBox[{"(", 
                  RowBox[{"n", "-", "1"}], ")"}], "*", "bd"}], "-", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", "n"}], "-", "1"}], ")"}], "*", "bu"}], "+", 
                "x0u"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"znu", "=", 
             RowBox[{
              RowBox[{"+", "1"}], "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", "*", "n", "*", "bd"}], "-", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", "n"}], "-", "1"}], ")"}], "*", "bu"}], "-", 
                "x0u"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"ynd", "=", 
             RowBox[{
              RowBox[{"-", "1"}], "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", "*", 
                 RowBox[{"(", 
                  RowBox[{"n", "-", "1"}], ")"}], "*", "bu"}], "-", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", "n"}], "-", "1"}], ")"}], "*", "bd"}], "+", 
                "x0d"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"znd", "=", 
             RowBox[{
              RowBox[{"-", "1"}], "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", "*", "n", "*", "bu"}], "-", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"2", "n"}], "-", "1"}], ")"}], "*", "bd"}], "-", 
                "x0d"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"pnau", "=", "\[IndentingNewLine]", 
             RowBox[{
              SuperscriptBox["\[ExponentialE]", 

         ",", "\[Sigma]", ",", "1", ",", "\[Mu]", ",", "nmax"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"tmat", "=", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
